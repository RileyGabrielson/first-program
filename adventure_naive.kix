; ------- INTRO ------- 

$class_id = 1
$adventurer_name = ""
$health = 10
$gold_amount = 0
$user_input = ""
$any_input = ""
$valid_input = 0

CLS
? "What is your name?"
?
GETS $adventurer_name

CLS
? "Choose your class:"
? "1: Warrior"
? "2: Rogue"
? "3: Wizard"
?
GET $class_id

; ------- MAIN LOOP ------- 

CLS
WHILE $user_input <> "q"
  GOSUB "MainMenu"
LOOP

? "Goodbye :)"
QUIT

; ------- UTILITIES ------- 

:MainMenu
CLS
? "What would you like to do?"
? "1: Train with the Guild (20 Gold)"
? "2: Enter the Dungeon"
? "3: Heal (20 Gold)"
? "4: Show Stats"
? "q: Quit"
?
GET $user_input

IF $user_input == "1"
  GOSUB "Train"  
ELSE
  IF $user_input == "2"
    GOSUB "Dungeon"  
  ELSE
    IF $user_input == "3"
      GOSUB "Heal"  
    ELSE
      IF $user_input == "4"
        GOSUB "DisplayStats"  
      ELSE
        IF $user_input == "q"
          ; Do Nothing, quit in main menu
        ELSE
          ? "Invalid input, try again"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF

RETURN


:DisplayStats
CLS

IF $class_id == "1" 
  ? "$adventurer_name the Warrior"
ENDIF
IF $class_id == "2" 
  ? "$adventurer_name the Rogue"
ENDIF
IF $class_id == "3" 
  ? "$adventurer_name the Wizard"
ENDIF

? "Health: $health"
? "Gold: $gold_amount"
?
GET $any_input
RETURN


:Train
CLS
? "TRAINING YO!"
?
GET $any_input
RETURN


:Dungeon
CLS
? "DUNGEON YO!"
?
GET $any_input
RETURN


:Heal
CLS
? "Healing"
?
GET $any_input
RETURN
