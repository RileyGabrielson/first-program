; ------- INTRO ------- 

$class_id = 1
$adventurer_name = ""
$health = 10
$gold_amount = 0
$user_input = ""
$any_input = ""
$valid_input = 0
$strength = 0
$dexterity = 0
$intelligence = 0

CLS
? "What is your name?"
?
GETS $adventurer_name

CLS
? "Choose your class:"
? "1: Warrior (Strength: 5, Dexterity: 2, Intelligence: 1)"
? "2: Rogue (Strength: 2, Dexterity: 5, Intelligence: 2)"
? "3: Wizard (Strength: 1, Dexterity: 2, Intelligence: 5)"
?
GET $class_id

IF $class_id == "1"
  $strength = 5
  $dexterity = 2
  $intelligence = 1
ELSE
  IF $class_id == "2"
    $strength = 2
    $dexterity = 5
    $intelligence = 2
  ELSE
    IF $class_id == "3"
      $strength = 1
      $dexterity = 2
      $intelligence = 5
    ENDIF
  ENDIF
ENDIF

; ------- MAIN LOOP ------- 

CLS
WHILE $user_input <> "q"
  GOSUB "MainMenu"
LOOP

? "Goodbye :)"
QUIT

; ------- UTILITIES ------- 

:MainMenu
CLS
? "What would you like to do?"
? "1: Train with the Guild (20 Gold)"
? "2: Enter the Dungeon"
? "3: Heal (20 Gold)"
? "4: Show Stats"
? "q: Quit"
?
GET $user_input

IF $user_input == "1"
  GOSUB "Train"  
ELSE
  IF $user_input == "2"
    GOSUB "Dungeon"  
  ELSE
    IF $user_input == "3"
      GOSUB "Heal"  
    ELSE
      IF $user_input == "4"
        GOSUB "DisplayStats"  
      ELSE
        IF $user_input == "q"
          ; Do Nothing, quit in main menu
        ELSE
          ? "Invalid input, try again"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF

RETURN


:DisplayStats
CLS

IF $class_id == "1" 
  ? "$adventurer_name the Warrior"
ENDIF
IF $class_id == "2" 
  ? "$adventurer_name the Rogue"
ENDIF
IF $class_id == "3" 
  ? "$adventurer_name the Wizard"
ENDIF

? "Health: $health"
? "Gold: $gold_amount"
? "Strength: $strength"
? "Dexterity: $dexterity"
? "Intelligence: $intelligence"
?
GET $any_input
RETURN


:Train
CLS
IF $gold_amount < 20
  ? "You need 20 gold to train!"
ELSE
  $gold_amount = $gold_amount - 20
  IF $class_id == "1"
    ? "You train with heavy weapons!"
    ? "Your strength increases by 1!"
    $strength = $strength + 1
  ELSE
    IF $class_id == "2"
      ? "You practice your stealth and agility!"
      ? "Your dexterity increases by 1!"
      $dexterity = $dexterity + 1
    ELSE
      IF $class_id == "3"
        ? "You study ancient tomes!"
        ? "Your intelligence increases by 1!"
        $intelligence = $intelligence + 1
      ENDIF
    ENDIF
  ENDIF
ENDIF
?
GET $any_input
RETURN


:Dungeon
CLS
? "You enter the dungeon..."
? "A monster appears!"
? "You fight bravely!"
?
GET $any_input

CLS
? "You defeated the monster!"
IF $class_id == "1"
  ? "Your strength helped you find more gold!"
  $gold_amount = $gold_amount + 10 + $strength
  $health = $health - 2
ELSE
  IF $class_id == "2"
    ? "Your dexterity helped you avoid damage!"
    $gold_amount = $gold_amount + 10
    $health = $health - (2 - $dexterity / 5)
  ELSE
    IF $class_id == "3"
      ? "Your intelligence helped you find magical items!"
      $gold_amount = $gold_amount + 10 + $intelligence
      $health = $health - 2
    ENDIF
  ENDIF
ENDIF
?
GET $any_input
RETURN


:Heal
CLS
IF $gold_amount < 20
  ? "You need 20 gold to heal!"
ELSE
  $gold_amount = $gold_amount - 20
  ? "You feel much better!"
  $health = 10
ENDIF
?
GET $any_input
RETURN
